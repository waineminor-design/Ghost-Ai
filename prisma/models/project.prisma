enum ProjectStatus {
  DRAFT
  ARCHIVED
}

model Project {
  id             String                @id @default(cuid())
  // Clerk user id of the creator.
  ownerId        String
  name           String
  description    String?
  status         ProjectStatus         @default(DRAFT)
  // Reserved: path to the canvas snapshot in Vercel Blob.
  canvasJsonPath String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  collaborators  ProjectCollaborator[]

  @@index([ownerId])
  @@index([createdAt])
}
