enum ProjectStatus {
  DRAFT
  ARCHIVED
}

model Project {
  id             String                @id @default(cuid())
  // Clerk user id of the creator.
  ownerId        String
  name           String
  description    String?
  status         ProjectStatus         @default(DRAFT)
  // Path of the canvas snapshot in Vercel Blob (set by the first save).
  canvasJsonPath String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  collaborators  ProjectCollaborator[]
  taskRuns       TaskRun[]

  @@index([ownerId])
  @@index([createdAt])
}
